{
  "name": "huston-tech-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4821",
    "build": "next build",
    "build:launch": "npm run check:placeholders && next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.4",
    "typescript": "^5",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1",
      "@isaacs/nonrecursive-glob-match": "1.0.3"
    }
  },
  "description": "Marketing website for Huston Tech (static export for Cloudflare Workers).",
  "engines": {
    "node": ">=22.12"
  }
}
