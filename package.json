{
  "name": "huston-tech-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4821",
    "build": "next build && node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/finish-build.mjs",
    "build:launch": "npm run check:config && npm run check:placeholders && next build && node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/finish-build.mjs",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "check:placeholders": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-placeholders.mjs",
    "sync:config": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-config.mjs",
    "check:config": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-config.mjs --check",
    "blocks:catalog": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/blocks-catalog.mjs",
    "check:content": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "check:design": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-design.mjs",
    "compare:screens": "node scripts/compare-screenshots.mjs",
    "check:scope": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-change-scope.mjs",
    "check:process": "node scripts/check-process.mjs",
    "report:changes": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/change-report.mjs",
    "strip:images": "node scripts/strip-image-metadata.mjs",
    "test:scripts": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/*.test.mjs\"",
    "test:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"worker/*.test.ts\" \"src/lib/*.test.ts\" \"src/blocks/*.test.ts\" \"src/collections/*.test.ts\" \"src/forms/*.test.ts\" \"src/brand/*.test.ts\" \"src/settings/*.test.ts\"",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun",
    "check": "npm run check:fast && npm run build",
    "check:fast": "npm run check:config && npm run check:process && npm run lint && npm run typecheck && npm run test:worker && npm run test:scripts && npm run check:design && npm run check:content"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.4",
    "typescript": "^5",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "basic-ftp": "6.2.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1",
      "@isaacs/nonrecursive-glob-match": "1.0.3"
    }
  },
  "description": "Marketing website for Huston Tech (static export for Cloudflare Workers).",
  "engines": {
    "node": ">=22.19",
    "npm": ">=10.9.2 <11"
  }
}
