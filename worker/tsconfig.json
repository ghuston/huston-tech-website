{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["./worker-configuration.d.ts", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../src/content/contact-fields.ts", "../src/content/auto-reply.ts", "../src/content/providers.ts", "../src/lib/contact-validation.ts", "../src/lib/first-name.ts"]
}
