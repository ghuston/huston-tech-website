{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(secrets/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings*.json)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/package.json)",
      "Edit(/wrangler.jsonc)",
      "Edit(/.gitignore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"],
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit-check.mjs"],
            "onFailure": "block",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-config.mjs"],
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-src.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
