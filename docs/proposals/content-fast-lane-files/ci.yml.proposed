name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Check generated config
        run: npm run check:config

      - name: Lint
        run: npm run lint

      - name: Type check
        run: npm run typecheck

      # Contact form Worker tests (worker/*.test.ts): Node's built-in test runner, fetch mocked, no network.
      - name: Worker tests
        run: npm run test:worker

      # Pages as blocks: every page file against the block library (plain-words errors), the catalog is up to date,
      # and block components use only the design and motion tokens. The build also refuses invalid pages.
      - name: Content check
        run: npm run check:content

      - name: Design check
        run: npm run check:design

      - name: Build static export
        run: npm run build

      - name: Verify deploy artifacts
        run: |
          for f in out/index.html out/404.html out/sitemap.xml out/robots.txt out/_headers; do
            test -s "$f" || { echo "Missing build artifact: $f"; exit 1; }
          done

      - name: Report unresolved placeholders (informational until launch)
        run: npm run check:placeholders
        continue-on-error: true

  # Accessibility scan (Playwright + axe) of the built site. A required check in the "Protect main" ruleset
  # (see docs/ruleset-protect-main.json), so a red result blocks merge. No `paths:` filter and no `if:`:
  # a skipped required check would block merging, so this job must always run.
  a11y:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      # fetch-depth 0: the content lane step compares the branch with its base.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build static export
        run: npm run build

      # Content lane (docs/proposals/content-fast-lane.md): for a pull request that changes only page files and no
      # menu, CONTENT_LANE_ROUTES names the pages it changed and the scan covers those. Anything else prints nothing,
      # so the scan covers every page as before. Same job, same name, same rules.
      - name: Pick pages (content lane)
        run: node scripts/content-lane.mjs --ci >> "$GITHUB_ENV"

      - name: Install Chromium
        run: npx playwright install --with-deps chromium

      - name: Accessibility scan
        run: npm run test:a11y

      - name: Upload Playwright report (failures only)
        if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7
          if-no-files-found: ignore

  # Lighthouse CI audit of the built site (served by scripts/preview.mjs so public/_headers applies). A required
  # check in the "Protect main" ruleset (see docs/ruleset-protect-main.json), so a red result blocks merge.
  # No `paths:` filter and no `if:` on the job: a skipped required check would block merging.
  # The `if:` on the two report steps below keeps the reports on failure too.
  lighthouse:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build static export
        run: npm run build

      # Content lane: same rule as in the a11y job. Thresholds are unchanged (lighthouserc.cjs).
      - name: Pick pages (content lane)
        run: node scripts/content-lane.mjs --ci >> "$GITHUB_ENV"

      # Uses the Google Chrome preinstalled on ubuntu-latest; no browser is downloaded.
      - name: Lighthouse CI
        run: npm run test:lighthouse

      - name: Score summary
        if: ${{ !cancelled() }}
        run: node scripts/lighthouse-summary.mjs >> "$GITHUB_STEP_SUMMARY"

      - name: Upload Lighthouse reports
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: lighthouse-reports
          path: .lighthouseci/
          # The folder name starts with a dot, and upload-artifact skips hidden files unless told otherwise.
          include-hidden-files: true
          retention-days: 14
          # warn, not ignore: a missing report folder (the run stopped early) should show as a warning, not a silent success.
          if-no-files-found: warn

  # Change scope check (scripts/check-change-scope.mjs; rules in scripts/change-scope-rules.mjs; docs/CHANGE-SCOPE.md).
  # On a pull request from a branch named change/..., or opened by the site editor's App, it fails on a file outside
  # tier 1, a bad image or a new [[placeholder]]; on every other pull request it only reports. It needs the full history
  # (fetch-depth: 0) to compare with the base branch.
  # The script reads GitHub's own variables (GITHUB_BASE_REF, GITHUB_HEAD_REF), so no branch name is pasted into a shell command.
  # PROPOSED: a required check (change the ruleset first, then copy this file). The job-level `if:` is removed so the
  # job always reports; outside a pull request `--ci` does nothing and passes. It is strict on `change/` branches and on
  # every pull request opened by the site editor's GitHub App (`editor.github.botLogin`), whatever the branch name.
  change-scope:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      # The code check uses the typescript dev dependency, so the packages are installed.
      - name: Install dependencies
        run: npm ci

      - name: Script tests
        run: node --test "scripts/*.test.mjs"

      - name: Change scope check
        run: node scripts/check-change-scope.mjs --ci

  # Change report: before and after screenshots of the pages a change touches, at phone and desktop width. Informational:
  # it never blocks a merge. The markdown goes to the job summary; the screenshots are in the uploaded artifact.
  change-report:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build static export
        run: npm run build

      - name: Install Chromium
        run: npx playwright install --with-deps chromium

      # Builds the base commit in a temporary git worktree for the "before" screenshots.
      - name: Change report
        run: node scripts/change-report.mjs --ci

      - name: Upload change report
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: change-report
          path: change-report/
          retention-days: 14
          if-no-files-found: ignore
