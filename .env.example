# Canonical site origin used for canonical URLs, Open Graph, sitemap and JSON-LD.
# Defaults to https://hustonlogic.com (the domain is owned; it is not attached to the Worker yet). No secrets belong here.
NEXT_PUBLIC_SITE_URL=https://hustonlogic.com

# ---------------------------------------------------------------------------
# Where secrets live. This file is committed: NEVER put a real value in it.
# Names only. The contact form Worker (worker/contact.ts) reads four secrets.
# They are commented out, so nothing here defines a variable.
#
#   Production        : Cloudflare Worker secrets (npx wrangler secret put <NAME>)
#   Branch previews   : the Preview base config (npx wrangler preview base-config secret put <NAME>)
#   Local development : not needed; wrangler dev runs in development mode with --var test values
#                       (README, "Local test of the Worker"). A git-ignored .dev.vars also works.
#   CI                : none; the Worker tests mock fetch
#
# Secrets the contact form Worker needs (names are listed in wrangler.jsonc, secrets.required):
#   RESEND_API_KEY               Resend API key, "Sending access" for the sending domain only
#   TURNSTILE_SECRET_KEY         Cloudflare Turnstile widget secret key
#   GOOGLE_SERVICE_ACCOUNT_KEY   the whole service-account JSON key file
#   GOOGLE_SHEET_ID              the ID of the Google Sheet that receives submissions
# ---------------------------------------------------------------------------
